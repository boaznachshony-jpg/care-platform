# Copy to .env and fill in locally. Never commit a real .env file.
# Names and safe descriptions only — no real values belong in this file
# (Constitution §17: no secrets in repository).

# --- apps/api ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORRELATION_HEADER=x-correlation-id
CORS_ORIGINS=http://localhost:5173,https://care-platform-web.vercel.app

# --- database (ADR-002) ---
# Two connections on purpose. The application must never hold an
# administrative credential: an owner/superuser role carries BYPASSRLS, which
# skips every Row Level Security policy, so a single query that forgets
# withTenant() would escape tenant isolation entirely.
#
# DATABASE_URL — the running application. Connects as the least-privilege
# `caredesk_app` role (NOBYPASSRLS, no DDL). Leave it unset to run the API on
# the in-memory repositories with no database at all.
# Through the Supabase Supavisor session pooler the username is the role name
# plus the project-ref suffix — `caredesk_app.<project-ref>`, NOT plain
# `caredesk_app` — and the port is 5432 (session mode; the 6543 transaction
# pooler cannot run migration DDL).
# DATABASE_URL=postgresql://caredesk_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://caredesk:caredesk@localhost:5432/caredesk_dev
# Production only: generate with `openssl rand -base64 32` and store in the
# deployment secret manager. Rotating it requires re-encrypting workspaces.
WORKSPACE_ENCRYPTION_KEY=

# DATABASE_ADMIN_URL — owner connection, used ONLY by `pnpm db:migrate` and
# `pnpm db:provision-app-role`. Never read by apps/api.
# DATABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/caredesk_dev

# CAREDESK_APP_DB_PASSWORD — the password `pnpm db:provision-app-role` sets on
# the caredesk_app role. Needed only while running that script; remove it from
# .env.local afterwards. Never pass it as a command-line argument (it would
# land in shell history and `ps` output) and never commit it.
CAREDESK_APP_DB_PASSWORD=

# Supabase Auth (ADR-001) — leave unset in Milestone 0; AuthService uses the
# in-memory mock adapter when these are absent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=caredesk-private-documents
# Independent private storage destination. Production refuses to start with
# primary document storage but without these three backup settings.
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_SERVICE_ROLE_KEY=
BACKUP_SUPABASE_STORAGE_BUCKET=caredesk-private-documents-backup
# Exact HTTPS route opened after a family member accepts a one-time invitation.
FAMILY_INVITE_REDIRECT_URL=https://care-platform-web.vercel.app/app

# Contact requests are submitted through the API so the destination address is
# never included in the browser bundle. Verify SUPPORT_FROM_EMAIL in Resend.
SUPPORT_DESTINATION_EMAIL=
SUPPORT_FROM_EMAIL=
RESEND_API_KEY=

# Email ownership boundary: Supabase Auth sends signup verification, password
# reset and security messages through its separately configured production SMTP.
# CareDesk uses the server-only Resend settings above only for transactional
# product notifications, support and application-owned invitations. Never add
# these values to VITE_* variables or browser bundles.

# Product subscription billing. `disabled` is the safe default. Card details
# are entered only on Cardcom's hosted page; CareDesk stores an application-
# encrypted provider token, never the card number or CVV.
BILLING_PROVIDER=disabled
BILLING_PRICE_AGOROT=3900
BILLING_VAT_RATE_BPS=1800
# The closed pilot is fully sponsored. Keep both this value at 100 and the
# charging-start date empty until each customer has received advance notice
# and the operator runs the explicit activation command below.
BILLING_LAUNCH_DISCOUNT_PERCENT=100
BILLING_SUCCESS_URL=https://care-platform-web.vercel.app/billing?setup=success
BILLING_FAILURE_URL=https://care-platform-web.vercel.app/billing?setup=failed
BILLING_WEBHOOK_URL=https://care-platform-api.vercel.app/billing/webhooks/cardcom
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
# Set true only after Cardcom confirms the terminal is configured as a
# standing-order terminal; token charging itself does not require this flag.
CARDCOM_MARK_AS_RECURRING=false
# Generate once with a password manager or `openssl rand -base64 32`; rotation
# requires re-encrypting existing provider tokens first.
CARDCOM_TOKEN_ENCRYPTION_KEY=
# At least 24 random characters; Vercel sends this to the daily cron route.
CRON_SECRET=

# AI provider abstraction (ADR-003) — must stay "mock" until an approved AI
# Privacy Impact Assessment and DPA exist.
AI_PROVIDER=mock

# --- apps/web ---
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=
# Browser-safe publishable/anon key only. Never put a service_role key in Vite variables.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development-only mock bearer token (matches apps/api's synthetic dev
# session; never seeded when NODE_ENV=production). Not a secret.
VITE_DEV_TOKEN=dev-local-token
# Public website configuration. Use the final custom domain before indexing.
VITE_PUBLIC_SITE_URL=https://care-platform-web.vercel.app
# Optional public account-request or scheduling form. When unset, the landing
# page explains that pilot accounts are invitation-only and links to sign-in.
VITE_PUBLIC_SIGNUP_URL=

# --- closed-pilot account provisioning (operator-only; never Vercel runtime vars) ---
# First create/invite the user in Supabase Auth, then copy that user's UUID here.
PILOT_AUTH_SUBJECT=
PILOT_EMAIL=
PILOT_DISPLAY_NAME=
PILOT_ACCOUNT_NAME=
# Must match the approved Supabase project/data-location decision.
PILOT_DATA_REGION=
# Optional: omit to create a new tenant. Supply only to idempotently re-run a known account.
PILOT_TENANT_ID=
# Set true only after that user has enrolled an AAL2 factor in Supabase Auth.
PILOT_MFA_REQUIRED=false

# --- explicit paid-subscription activation (operator-only; never Vercel vars) ---
BILLING_ACTIVATION_TENANT_ID=
BILLING_ACTIVATION_START_DATE=
# Exact acknowledgement required by the activation script. It is deliberately
# verbose so a sponsored pilot can never silently become paid.
BILLING_ACTIVATION_CONFIRMATION=
