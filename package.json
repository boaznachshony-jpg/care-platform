{
  "name": "caredesk",
  "private": true,
  "version": "0.0.0",
  "description": "CareDesk Israel monorepo — Milestone 0 foundation",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @caredesk/web dev",
    "dev:api": "pnpm --filter @caredesk/api dev",
    "db:migrate": "node --env-file=.env.local --import tsx packages/db/src/cli.ts",
    "db:provision-app-role": "node --env-file=.env.local --import tsx packages/db/src/provision-app-role.ts",
    "db:rls-test": "node --env-file=.env.local --import tsx packages/db/src/rls-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:a11y": "pnpm --filter @caredesk/web test:a11y",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
