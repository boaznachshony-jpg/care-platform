{
  "name": "@caredesk/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@caredesk/application": "workspace:*",
    "@caredesk/config": "workspace:*",
    "@caredesk/db": "workspace:*",
    "@caredesk/domain": "workspace:*",
    "@caredesk/infrastructure": "workspace:*",
    "@caredesk/schemas": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
