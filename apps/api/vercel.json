{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/caredesk-ux-v2-visual": false,
      "test/pr-160-external-preview": false
    }
  },
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @caredesk/api... build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/billing/jobs/collect", "schedule": "17 4 * * *" },
    { "path": "/internal/jobs/data-integrity-scan", "schedule": "42 3 * * *" }
  ]
}
